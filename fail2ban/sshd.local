# /etc/fail2ban/jail.d/sshd.local — жёсткая защита SSH для Debian 13
# Файлы jail.d/*.local читаются последними и перекрывают настройки по умолчанию.

[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
# Debian 13 пишет логи только в journald, /var/log/auth.log нет
backend = systemd
# бан только на порт SSH — остальные сервисы забаненному IP доступны
banaction = nftables-multiport
banaction_allports = nftables-allports

# 3 неудачные попытки за сутки — бан на сутки
findtime = 1d
maxretry = 3
bantime = 1d
# каждый повторный бан того же IP в 2 раза дольше: 1 → 2 → 4 → 8 → 16 → 32 дня, максимум 5 недель
bantime.increment = true
bantime.factor = 1
bantime.maxtime = 5w

[sshd]
enabled = true
# aggressive ловит ещё и сканеры, которые рвут соединение до ввода пароля
mode = aggressive
# в Debian служба называется ssh.service, в OpenSSH 10 логи пишет sshd-session —
# фильтр по юниту ловит все его записи
journalmatch = _SYSTEMD_UNIT=ssh.service
